+    /// Read the most recent command output using semantic prompt metadata.
+    ///
+    /// This requires shell integration prompt markers to be active.
+    export fn ghostty_surface_read_last_output(
+        surface: *Surface,
+        result: *Text,
+    ) bool {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+
+        const core_sel = lastOutputSelectionLocked(
+            core_surface.renderer_state.terminal.screens.active,
+        ) orelse return false;
+
+        return readTextLocked(surface, core_sel, result);
+    }
